# scripted = deterministic demonstration; real = actual model tool calling
MODEL_MODE=scripted
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
LLM_API_KEY=
# NVIDIA: base URL https://integrate.api.nvidia.com/v1, model z-ai/glm-5.3
# For GLM smoke tests: timeout 180, output tokens 4096, reasoning effort low.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1500
LLM_REASONING_EFFORT=
DATA_DIR=data
MAX_MODEL_CALLS=30
MAX_TOTAL_TOKENS=60000
RUN_TIMEOUT_SECONDS=180
# See README for the latest validated real-model configuration (kimi-k3).
# Keep MODEL_MODE=scripted for a key-free first run.
